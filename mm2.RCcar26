	Instance.new("UICorner", VoiceButton).CornerRadius = UDim.new(1, 0)

	local VStroke = Instance.new("UIStroke", VoiceButton)
	VStroke.Name = "VStroke"
	VStroke.Color = Color3.fromRGB(100, 100, 100)
	VStroke.Thickness = 1.5
	VStroke.Transparency = 0.5

	local VoiceIcon = Instance.new("ImageLabel", VoiceButton)
	VoiceIcon.BackgroundTransparency = 1
	VoiceIcon.Size = UDim2.new(0, iconSize, 0, iconSize) 
	VoiceIcon.Position = UDim2.new(0.5, -iconSize/2, 0.5, -iconSize/2)
	VoiceIcon.Image = "rbxassetid://128627317841330"

	local VLabel = Instance.new("TextLabel", VoiceButton)
	VLabel.BackgroundTransparency = 1
	VLabel.Size = UDim2.new(0, 16, 0, 16)
	VLabel.Position = UDim2.new(1, -16, 1, -16)
	VLabel.Font = Enum.Font.GothamBold
	VLabel.Text = "V"
	VLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	VLabel.TextSize = 14
	VLabel.Visible = UserInputService.KeyboardEnabled

	VoiceButton.MouseButton1Click:Connect(function()
		setVoiceState(not voiceModeActive)
	end)
end

