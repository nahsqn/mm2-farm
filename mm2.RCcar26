local VoiceButton = nil

local function removeVoiceButton()
	if VoiceButton then
		VoiceButton:Destroy()
		VoiceButton = nil
	end
end

local function setVoiceState(state)
	if voiceModeActive == state then return end
	voiceModeActive = state

	if voiceModeActive then openSound:Play() else closeSound:Play() end

	if VoiceButton then
		local stroke = VoiceButton:FindFirstChild("VStroke")
		if voiceModeActive then
			VoiceButton.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
			VoiceButton.BackgroundTransparency = 0.1
			if stroke then stroke.Color = Color3.fromRGB(255, 255, 255) stroke.Transparency = 0.2 end
		else
			VoiceButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
			VoiceButton.BackgroundTransparency = 0.3
			if stroke then stroke.Color = Color3.fromRGB(80, 80, 100) stroke.Transparency = 0.5 end
		end
	end
end

local function createVoiceButton()
	if VoiceButton then return end
	
	VoiceButton = Instance.new("TextButton")
	VoiceButton.Name = "VoiceToggleButton"
	VoiceButton.Parent = container 
	VoiceButton.Size = UDim2.new(0, buttonSize, 0, buttonSize) 
	VoiceButton.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
