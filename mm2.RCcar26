		setVoiceState(false)
		VCBtnToggle.Text = "VC Butonu Ekle/Çıkar: YOK"
		VCBtnToggle.TextColor3 = Color3.fromRGB(200, 200, 200)
	else
		createVoiceButton()
		setVoiceState(false)
		VCBtnToggle.Text = "VC Butonu Ekle/Çıkar: VAR"
		VCBtnToggle.TextColor3 = Color3.fromRGB(100, 255, 100)
	end
end)

