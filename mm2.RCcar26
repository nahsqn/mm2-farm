local safePlatform = workspace:FindFirstChild("RCCarSafePlatform")
if not safePlatform then
	safePlatform = Instance.new("Part")
	safePlatform.Name = "RCCarSafePlatform"
	safePlatform.Size = Vector3.new(150, 2, 150)
	safePlatform.Position = Vector3.new(0, 6000, 0)
	safePlatform.Anchored = true
	safePlatform.Material = Enum.Material.SmoothPlastic
	safePlatform.Color = Color3.fromRGB(35, 35, 35)
	safePlatform.Parent = workspace
end

local activeDrivingConnection = nil

local function teleportToCarAndCleanup()
	if activeDrivingConnection then
		activeDrivingConnection:Disconnect()
		activeDrivingConnection = nil
	end
	
	isDrivingActive = false
	DriveToggleBtn.Text = "SÜRÜŞ MODU: PASİF"
	DriveToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
	if humanoid then
		humanoid.PlatformStand = false
		humanoid.WalkSpeed = 16
		humanoid.AutoRotate = true
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		Camera.CameraSubject = humanoid
	end
	
	Camera.CameraType = Enum.CameraType.Custom
end

local function raycastSolid(p9, p10, rayParams, ignoreList)
	for _ = 1, 8 do
		local v13 = workspace:Raycast(p9, p10, rayParams)
		local v14 = v13 and v13.Instance
		if not v14 or (not v14:IsA("BasePart") or (v14:IsA("Terrain") or (v14.Transparency < 1 or v14.CanCollide))) then
			return v13
		end
		table.insert(ignoreList, v14)
		rayParams.FilterDescendantsInstances = ignoreList
	end
	return nil
end

local PlayerControls = nil
pcall(function()
	local ps = LocalPlayer:WaitForChild("PlayerScripts", 3)
	if ps then
		local pm = ps:WaitForChild("PlayerModule", 3)
		if pm then PlayerControls = require(pm):GetControls() end
	end
end)

local function startDriving(p_u_17)
	if activeDrivingConnection then
		activeDrivingConnection:Disconnect()
		activeDrivingConnection = nil
	end
	
	isDrivingActive = true
	DriveToggleBtn.Text = "SÜRÜŞ MODU: AKTİF"
	DriveToggleBtn.TextColor3 = Color3.fromRGB(0, 200, 100)

	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
	if humanoid then
		humanoid.PlatformStand = true
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end

	-- Sadece Karakter Güvenli Platforma Alınır
	if hrp then
		hrp.CFrame = safePlatform.CFrame + Vector3.new(0, 5, 0)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	
	local gravity = workspace.Gravity
	local v_u_18 = p_u_17:WaitForChild("Body", 3) or p_u_17.PrimaryPart or p_u_17:FindFirstChildWhichIsA("BasePart")
	local v_u_19 = {}
	if v_u_18 then
		for _, v20 in ipairs(v_u_18:GetChildren()) do
			if v20:IsA("Weld") then table.insert(v_u_19, v20) end
		end
	end
	
	local v21, v22 = p_u_17:GetBoundingBox()
	local v_u_23 = p_u_17:GetPivot().Position.Y - (v21.Position.Y - v22.Y / 2)
	local v_u_24 = v22.Z / 2
	local v_u_25 = v22.X / 2
	local v26 = p_u_17:FindFirstChild("LeftFrontWheel")
	local v_u_27 = not v26 and 0.374 or v26.Size.Y / 2
	local v28 = p_u_17:GetPivot().LookVector
	local v_u_31 = math.atan2(-v28.X, -v28.Z)
	local currentMoveSpeed = 0
	local v_u_33 = 0
	local v_u_34 = false
	local v_u_35, v_u_36 = 0, 0
	local currentNormal = Vector3.new(0, 1, 0)
	
	activeDrivingConnection = RunService.Heartbeat:Connect(function(p39)
		p39 = math.min(p39, 0.1)
		
		if not p_u_17 or not p_u_17.Parent or not isDrivingActive then
			teleportToCarAndCleanup()
			return
		end
		
		local v40 = LocalPlayer.Character
		local v40_hrp = v40 and v40:FindFirstChild("HumanoidRootPart")
		
		local v42 = (not isAuthorizedToControl and PlayerControls) and PlayerControls:GetMoveVector() or Vector3.zero
		local v43 = -v42.Z
		local v44 = v42.X
		
		local maxSpeed = math.clamp(getgenv().CarSpeed or 30, 1, 100)
		local accelRate = maxSpeed * 2.5
		
		if v43 > 0.05 then
			if currentMoveSpeed < 0 then
				currentMoveSpeed = math.min(currentMoveSpeed + accelRate * 1.5 * p39, 0)
			else
				currentMoveSpeed = math.min(currentMoveSpeed + accelRate * v43 * p39, maxSpeed)
			end
		elseif v43 < -0.05 then
			if currentMoveSpeed > 0 then
				currentMoveSpeed = math.max(currentMoveSpeed - accelRate * 1.5 * p39, 0)
			else
				currentMoveSpeed = math.max(currentMoveSpeed + accelRate * v43 * p39, -maxSpeed)
			end
		elseif currentMoveSpeed > 0 then
			currentMoveSpeed = math.max(currentMoveSpeed - accelRate * p39, 0)
		else
			currentMoveSpeed = math.min(currentMoveSpeed + accelRate * p39, 0)
		end
		
		if math.abs(v44) > 0.05 and not v_u_34 then
			local turnFactor = math.clamp(math.abs(currentMoveSpeed) / 8.4, 0.2, 1)
			local directionSign = currentMoveSpeed >= 0 and 1 or -1
			if currentMoveSpeed == 0 then directionSign = 1 end
			v_u_31 = v_u_31 - v44 * math.pi * turnFactor * directionSign * p39 * 1.3
		end
		
		local v56 = p_u_17:GetPivot().Position
		local v61 = Vector3.new(-math.sin(v_u_31), 0, -math.cos(v_u_31))
		
		local v62 = RaycastParams.new()
		local v63 = { p_u_17 }
		
		for _, v64 in ipairs(Players:GetPlayers()) do
			if v64.Character then table.insert(v63, v64.Character) end
		end
		for _, ignoredObj in ipairs(ignoredObjects) do
			if ignoredObj and ignoredObj.Parent then table.insert(v63, ignoredObj) end
		end
		
		v62.FilterDescendantsInstances = v63
		
		local stepHeight = 3.5
		if currentMoveSpeed ~= 0 then
			local v67 = currentMoveSpeed >= 0 and v61 or -v61
			local v68 = v67 - currentNormal * v67:Dot(currentNormal)
			if v68.Magnitude > 0.01 then v67 = v68.Unit end
			local v69 = v61:Cross(Vector3.new(0, 1, 0))
			local v71 = v_u_24 + 0.1 + math.abs(currentMoveSpeed) * p39
			local v72 = v56 - currentNormal * (v_u_23 - stepHeight)
			local v73 = false
			for _, v74 in { -v_u_25 * 0.3, 0, v_u_25 * 0.3 } do
				local v75 = v69 * v74
				for _, v76 in { v56 + v75 + Vector3.new(0, stepHeight, 0), v72 + v75 } do
					local v77 = raycastSolid(v76, v67 * v71, v62, v63)
					if v77 and v77.Normal.Y < 0.1 then
						v73 = true
						break
					end
				end
				if v73 then break end
			end
			if v73 then currentMoveSpeed = 0 end
		end
		
		local v78 = v56 + v61 * currentMoveSpeed * p39
		local targetNormal = Vector3.new(0, 1, 0)
		local v80 = raycastSolid(v78 + Vector3.new(0, stepHeight + 2, 0), Vector3.new(0, -64, 0), v62, v63)
		local v81 = v80 and (v80.Position.Y + v_u_23) or nil
		
		if v_u_34 then
			v_u_35 = v_u_35 - gravity * p39
			local v82 = v56.Y + v_u_35 * p39
			if v81 and (v_u_35 <= 0 and v82 <= v81) then
				v_u_34 = false
				v_u_35 = 0
				v_u_36 = 0
				targetNormal = v80.Normal
			else
				v81 = v82
			end
			v56 = Vector3.new(v78.X, v81, v78.Z)
		elseif v81 then
			if v56.Y - (stepHeight + 1.2) <= v81 then
				local v86 = math.min(v81, v56.Y + 100 * p39)
				v_u_36 = (v86 - v56.Y) / p39
				v56 = Vector3.new(v78.X, v86, v78.Z)
				targetNormal = v80.Normal
			else
				v_u_34 = true
				v_u_35 = math.max(v_u_36, 0)
				v56 = Vector3.new(v78.X, v56.Y + v_u_35 * p39, v78.Z)
			end
		else
			currentMoveSpeed = 0
		end
		
		currentNormal = currentNormal:Lerp(targetNormal, math.min(p39 * 25, 1))
		
		local forwardVector = v61
		local rightVector = forwardVector:Cross(currentNormal)
		if rightVector.Magnitude > 0.001 then
			rightVector = rightVector.Unit
			local adjustedForward = currentNormal:Cross(rightVector).Unit
			local targetCFrame = CFrame.fromMatrix(v56, rightVector, currentNormal, -adjustedForward)
			p_u_17:PivotTo(targetCFrame)
		end
		
		-- Sadece Oyuncak Arabaya Kamera Odaklama
		local camTarget = p_u_17.PrimaryPart or v_u_18
		if Camera.CameraSubject ~= camTarget then
			Camera.CameraSubject = camTarget
		end
		
		if v40_hrp and v40_hrp.Position.Y < 5000 then
			v40_hrp.CFrame = safePlatform.CFrame + Vector3.new(0, 5, 0)
			v40_hrp.AssemblyLinearVelocity = Vector3.zero
		end

		if v_u_18 then
			v_u_18.AssemblyLinearVelocity = Vector3.zero
			v_u_18.AssemblyAngularVelocity = Vector3.zero
		end
		v_u_33 = v_u_33 + currentMoveSpeed / v_u_27 * p39
		local v103 = CFrame.Angles(v_u_33, 0, 0)
		for _, v104 in ipairs(v_u_19) do v104.C1 = v103 end
	end)
end

DriveToggleBtn.MouseButton1Click:Connect(function()
	if isAuthorizedToControl then return end
	if isDrivingActive then
		teleportToCarAndCleanup()
	else
		local char = LocalPlayer.Character
		local tool = char and char:FindFirstChild("RCCar26")
		if tool then
			local carModel = workspace:FindFirstChild("RCCars") and workspace.RCCars:FindFirstChild(LocalPlayer.Name)
			if carModel then
				startDriving(carModel)
			end
		end
	end
end)

local hookedTools = {}
local function hookTool(tool)
	if tool.Name == "RCCar26" and not hookedTools[tool] then
		hookedTools[tool] = true
		local carStateChanged = tool:WaitForChild("CarStateChanged", 3)
		if carStateChanged then
			carStateChanged.OnClientEvent:Connect(function(carModel)
				if carModel then
					startDriving(carModel)
				else
					teleportToCarAndCleanup()
				end
			end)
		end
		
		tool.Unequipped:Connect(teleportToCarAndCleanup)
		tool.AncestryChanged:Connect(function(_, parent)
			if not parent or parent == workspace then
				teleportToCarAndCleanup()
			end
		end)
	end
end

local function monitorCharacter(char)
	if not char then return end
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then hookTool(child) end
	end)
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") then hookTool(child) end
	end
end

if LocalPlayer.Character then monitorCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(monitorCharacter)

local backpack = LocalPlayer:WaitForChild("Backpack", 3)
if backpack then
	backpack.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then hookTool(child) end
	end)
	for _, child in ipairs(backpack:GetChildren()) do
		if child:IsA("Tool") then hookTool(child) end
	end
end
