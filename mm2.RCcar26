	elseif input.KeyCode == Enum.KeyCode.V and VoiceButton then
		setVoiceState(not voiceModeActive)
	end
end)

-------------------------------------------------------------------
-- // Noclip Filtresi
-------------------------------------------------------------------
local ignoredObjects = {}

local function addIgnoredPart(part)
	if part:IsA("BasePart") then
		part.CanCollide = false
		if not table.find(ignoredObjects, part) then table.insert(ignoredObjects, part) end
	end
end

local function isTargetIgnored(inst)
	local name = string.lower(inst.Name)
	return name:find("coin") or name:find("rag") or name:find("raggy") or name:find("corpse")
end

local function applyNoclipToTree(inst)
	if isTargetIgnored(inst) then
		addIgnoredPart(inst)
		for _, child in ipairs(inst:GetDescendants()) do addIgnoredPart(child) end
	end
end

for _, desc in ipairs(workspace:GetDescendants()) do applyNoclipToTree(desc) end
workspace.DescendantAdded:Connect(function(desc)
	task.wait()
	applyNoclipToTree(desc)
	if desc.Parent and isTargetIgnored(desc.Parent) then addIgnoredPart(desc) end
end)

