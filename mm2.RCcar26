task.spawn(function()
	while MainFrame and ScreenGui.Parent do
		task.wait(0.1)
		if MainFrame.Visible then
			local t1 = TweenService:Create(ButtonStroke, TweenInfo.new(0.4), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0})
			t1:Play()
			t1.Completed:Wait()
			if not MainFrame.Visible then break end
			
			local t2 = TweenService:Create(ButtonStroke, TweenInfo.new(0.4), {Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7})
			t2:Play()
			t2.Completed:Wait()
		else
			ButtonStroke.Color = Color3.fromRGB(100, 100, 100)
			ButtonStroke.Transparency = 0.5
			task.wait(0.2)
		end
	end
end)

local function toggleMenu()
	MainFrame.Visible = not MainFrame.Visible
end

