local VoiceButton = nil

local function removeVoiceButton()
	if VoiceButton then
		VoiceButton:Destroy()
		VoiceButton = nil
	end
end

local function setVoiceState(state)
	if voiceModeActive == state then return end
	voiceModeActive = state

	if voiceModeActive then
		openSound:Play()
	else
		closeSound:Play()
	end

	if VoiceButton then
		local stroke = VoiceButton:FindFirstChild("VStroke")
		if voiceModeActive then
			VoiceButton.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
			VoiceButton.BackgroundTransparency = 0.2
			if stroke then
				stroke.Color = Color3.fromRGB(255, 255, 255)
				stroke.Transparency = 0.3
			end
		else
			VoiceButton.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
			VoiceButton.BackgroundTransparency = 0.3
			if stroke then
				stroke.Color = Color3.fromRGB(100, 100, 100)
				stroke.Transparency = 0.5
			end
		end
	end
end

local function createVoiceButton()
	if VoiceButton then return end
	
	VoiceButton = Instance.new("TextButton")
