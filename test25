		sendEnhancedWebhook()
	end

	if current == max and not resetting and autoResetEnabled then
		resetting = true
		bag_full = true
		farming = false
		local hrp = getHRP()
		if start_position then
			local tween = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = start_position})
			tween:Play()
			tween.Completed:Wait()
		end
		task.wait(0.5)
		LocalPlayer.Character.Humanoid.Health = 0
		LocalPlayer.CharacterAdded:Wait()
		task.wait(1.5)
		resetting = false
		bag_full = false
	end
end)

-- Farm Döngüsü (Eski oturum algılandığında anında durur)
task.spawn(function()
	while true do
		task.wait(0.1)
		if getgenv().MM2FarmSession ~= mySession then break end
		if autoFarmEnabled and farming and not bag_full and not isDead and roundActive then
			local coin, dist = get_nearest_coin()
			if coin then
				local hrp = getHRP()
				local function tweenTo(targetPos)
					if getgenv().MM2FarmSession ~= mySession then return end
					local distance = (hrp.Position - targetPos).Magnitude
					local duration = distance / farmSpeed
					if duration < 0.05 then duration = 0.05 end
					local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
					local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
					tween:Play()
					tween.Completed:Wait()
				end

				if undergroundMode then
					local currentPos = hrp.Position
					local coinPos = coin.Position
					local undergroundY = coinPos.Y - 9

					tweenTo(Vector3.new(currentPos.X, undergroundY, currentPos.Z))
					tweenTo(Vector3.new(coinPos.X, undergroundY, coinPos.Z))
					tweenTo(coinPos)
					collectedCoins[coin] = tick()
					task.wait(0.1)
					tweenTo(Vector3.new(coinPos.X, undergroundY, coinPos.Z))
				else
					tweenTo(coin.Position)
					collectedCoins[coin] = tick()
					task.wait(0.05)
				end
			else
				task.wait(0.5)
			end
		end
	end
end)

