local function getCharacter()
	return Player.Character or Player.CharacterAdded:Wait()
end

local function getHRP()
	return getCharacter():WaitForChild("HumanoidRootPart")
end

local collectedCoins = {}
local COIN_COOLDOWN = 3
local isDead = false
local roundActive = false

local function isCoinValid(coin)
	if not coin or not coin.Parent then return false end
	if not coin:FindFirstChild("TouchInterest") then return false end
	if collectedCoins[coin] then
		if tick() - collectedCoins[coin] < COIN_COOLDOWN then
			return false
		else
			collectedCoins[coin] = nil
		end
	end
	return true
end

local function get_nearest_coin()
	local hrp = getHRP()
	local closest, dist = nil, math.huge
	for _, m in pairs(workspace:GetChildren()) do
		if m:FindFirstChild("CoinContainer") then
			for _, coin in pairs(m.CoinContainer:GetChildren()) do
				if coin:IsA("BasePart") and isCoinValid(coin) then
					local d = (hrp.Position - coin.Position).Magnitude
					if d < dist then
						closest, dist = coin, d
					end
				end
			end
		end
	end
	return closest, dist
end

-- // Webhook Gönderme Fonksiyonu
local function sendEnhancedWebhook()
	if webhookURL == "" or not webhookURL:find("discord.com") then return end
	local diff = os.difftime(os.time(), startTime)
	local h = math.floor(diff / 3600)
	local m = math.floor((diff % 3600) / 60)
	local s = diff % 60
	local perHour = (diff > 0) and math.floor((totalCoins / (diff / 3600))) or 0
	local headshot = "https://www.roblox.com/headshot-thumbnail/image?userId="..Player.UserId.."&width=420&height=420&format=png"
	
	local data = {
		["embeds"] = {{
			["title"] = "🚀 MM2 Farm Raporu (VOİD Hub)",
			["description"] = "**Durum:** Farm Devam Ediyor...",
			["color"] = 14513407,
			["thumbnail"] = {["url"] = headshot},
			["fields"] = {
				{["name"] = "👤 Oyuncu", ["value"] = "```" .. Player.Name .. "```", ["inline"] = true},
				{["name"] = "⏳ Toplam Süre", ["value"] = "```" .. string.format("%02d:%02d:%02d", h, m, s) .. "```", ["inline"] = true},
				{["name"] = "🪙 Toplam Coin", ["value"] = "```" .. totalCoins .. "```", ["inline"] = true},
				{["name"] = "📈 Saatlik Hız", ["value"] = "```" .. perHour .. " Coin/Saat```", ["inline"] = true}
			},
			["footer"] = { ["text"] = "MM2 Farm Hub - Türkçe Sistem", ["icon_url"] = headshot }
		}}
	}
	
	local request = (syn and syn.request) or (http and http.request) or http_request or request
	pcall(function()
		if request then
			request({
				Url = webhookURL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = game:GetService("HttpService"):JSONEncode(data)
			})
		end
	end)
	lastWebhook = os.time()
end

