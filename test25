local function detectLanguage()
	local success, locale = pcall(function()
		return LocalPlayer.LocaleId or LocalizationService:GetAbridgedRobloxLocale() or "en"
	end)
	if success and locale then
		locale = locale:sub(1, 2):upper()
		if locale == "TR" then
			return "TR"
		end
	end
	return "EN"
end

