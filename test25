-- // Coin Toplama & Sayma & Otomatik Sıfırlama
local CoinCollected = ReplicatedStorage.Remotes.Gameplay.CoinCollected
local CoinLabelRef, TimeLabelRef

CoinCollected.OnClientEvent:Connect(function(_, current, max)
	totalCoins = totalCoins + 1
	if CoinLabelRef then
		CoinLabelRef.Text = "Coin: " .. tostring(totalCoins)
	end
	
	if current >= max then
		sendEnhancedWebhook()
	end

	if current == max and not resetting and autoResetEnabled then
		resetting = true
		bag_full = true
		farming = false
		local hrp = getHRP()
		if start_position then
			local tween = TweenService:Create(hrp, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = start_position})
			tween:Play()
			tween.Completed:Wait()
		end
		task.wait(0.5)
		Player.Character.Humanoid.Health = 0
		Player.CharacterAdded:Wait()
		task.wait(1.5)
		resetting = false
		bag_full = false
	end
end)

-- // ANA FARM DÖNGÜSÜ
task.spawn(function()
	while true do
		if autoFarmEnabled and farming and not bag_full and not isDead and roundActive then
			local coin, dist = get_nearest_coin()
			if coin then
				local hrp = getHRP()
				local function tweenTo(targetPos)
					local distance = (hrp.Position - targetPos).Magnitude
					local duration = distance / farmSpeed
					if duration < 0.05 then duration = 0.05 end
					local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
					local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
					tween:Play()
					tween.Completed:Wait()
				end

				if undergroundMode then
					local currentPos = hrp.Position
					local coinPos = coin.Position
					local undergroundY = coinPos.Y - 9

					local dropDownPos = Vector3.new(currentPos.X, undergroundY, currentPos.Z)
					tweenTo(dropDownPos)

					local coinUndergroundPos = Vector3.new(coinPos.X, undergroundY, coinPos.Z)
					tweenTo(coinUndergroundPos)

					tweenTo(coinPos)
					collectedCoins[coin] = tick()
					task.wait(0.1)

					tweenTo(coinUndergroundPos)
				else
					tweenTo(coin.Position)
					collectedCoins[coin] = tick()
					task.wait(0.05)
				end
			else
				task.wait(0.5)
			end
		else
			task.wait(0.5)
		end
	end
end)

