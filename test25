local NoclipToggleCircle = Instance.new("Frame", NoclipToggle)
NoclipToggleCircle.Size = UDim2.new(0, 16, 0, 16)
NoclipToggleCircle.Position = UDim2.new(0.87, 0, 0.23, 0)
NoclipToggleCircle.BackgroundColor3 = Color3.fromRGB(100, 40, 140)
NoclipToggleCircle.BorderSizePixel = 0
Instance.new("UICorner", NoclipToggleCircle).CornerRadius = UDim.new(1, 0)

local function setNoclip(enabled)
	noclipEnabled = enabled
	if noclipEnabled then
		NoclipToggleCircle.BackgroundColor3 = Color3.fromRGB(200, 120, 255)
		NoclipLabel.Text = "🚫 Noclip AÇIK"
		NoclipLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
		noclipConnection = RunService.Stepped:Connect(function()
			local char = Player.Character
			if char then
				for _, part in pairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	else
		NoclipToggleCircle.BackgroundColor3 = Color3.fromRGB(100, 40, 140)
		NoclipLabel.Text = "🚫 Noclip"
		NoclipLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
		local char = Player.Character
		if char then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
				end
			end
		end
	end
end

NoclipToggle.MouseButton1Click:Connect(function()
	setNoclip(not noclipEnabled)
end)

Player.CharacterAdded:Connect(function()
	if noclipEnabled then
		task.wait(0.5)
		setNoclip(true)
	end
end)

