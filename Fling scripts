local function refreshList()
    for _, v in pairs(scroll:GetChildren()) do
        if v:IsA("Frame") or v:IsA("TextButton") then
            v:Destroy()
        end
    end
    table.clear(playerRows)
    
    for _, p in pairs(players:GetPlayers()) do
        if p ~= lplayer then
            local isFriendPlayer = isFriend(p)
            
            local row = Instance.new("TextButton")
            row.Name = p.Name .. "_Row"
            row.Size = UDim2.new(1, -10, 0, 70)
            row.BackgroundColor3 = isFriendPlayer and Color3.fromRGB(50, 45, 30) or Color3.fromRGB(35, 35, 35)
            row.Text = ""
            row.AutoButtonColor = false
            row.LayoutOrder = #scroll:GetChildren()
            row.Parent = scroll
            
            if isFriendPlayer then
                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(255, 200, 50)
                stroke.Thickness = 2
                stroke.Parent = row
            end
            
            playerRows[p] = row
            
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 12)
            
            local avatarImg = Instance.new("ImageLabel")
            avatarImg.Name = "Avatar"
            avatarImg.Size = UDim2.new(0, 50, 0, 50)
            avatarImg.Position = UDim2.new(0, 10, 0.5, -25)
            avatarImg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            avatarImg.BorderSizePixel = 0
            avatarImg.Image = getAvatarUrl(p.UserId)
            avatarImg.Parent = row
            Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(1, 0)
            
            local displayName = Instance.new("TextLabel")
            displayName.Name = "DisplayName"
            displayName.Text = p.DisplayName
            displayName.Size = UDim2.new(1, -80, 0, 25)
            displayName.Position = UDim2.new(0, 70, 0, 10)
            displayName.Font = Enum.Font.BuilderSansBold
            displayName.TextSize = 16
            displayName.TextColor3 = isFriendPlayer and Color3.fromRGB(255, 220, 100) or Color3.new(1, 1, 1)
            displayName.TextXAlignment = Enum.TextXAlignment.Left
            displayName.BackgroundTransparency = 1
            displayName.Parent = row
            
            local userName = Instance.new("TextLabel")
            userName.Name = "UserName"
            userName.Text = "@" .. p.Name .. (isFriendPlayer and " (Arkadaş)" or "")
            userName.Size = UDim2.new(1, -80, 0, 20)
            userName.Position = UDim2.new(0, 70, 0, 35)
            userName.Font = Enum.Font.BuilderSansMedium
            userName.TextSize = 14
            userName.TextColor3 = isFriendPlayer and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(150, 150, 150)
            userName.TextXAlignment = Enum.TextXAlignment.Left
            userName.BackgroundTransparency = 1
            userName.Parent = row
            
            local statusDot = Instance.new("Frame")
            statusDot.Name = "StatusDot"
            statusDot.Size = UDim2.new(0, 8, 0, 8)
            statusDot.Position = UDim2.new(1, -20, 0.5, -4)
            statusDot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            statusDot.BorderSizePixel = 0
            statusDot.Parent = row
            Instance.new("UICorner", statusDot).CornerRadius = UDim.new(1, 0)
            
            row.MouseEnter:Connect(function()
                if not selectedTargets[p.Name] then
                    if isFriendPlayer then
                        tweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 55, 40)}):Play()
                    else
                        tweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 50, 50)}):Play()
                    end
                end
            end)
            
            row.MouseLeave:Connect(function()
                if not selectedTargets[p.Name] then
                    if isFriendPlayer then
                        tweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 45, 30)}):Play()
                    else
                        tweenService:Create(row, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
                    end
                end
            end)
            
            row.MouseButton1Click:Connect(function()
                toggleSelection(p)
            end)
        end
    end
    
    highlightSelectedTargets()
end

local function showAlert()
    if isAlertOpen then return end
    isAlertOpen = true
    
    alertBox.Position = UDim2.new(0.5, -160, 0.5, -80)
    alertBox.BackgroundTransparency = 1
    overlay.BackgroundTransparency = 1
    
    alertGui.Enabled = true
    
    tweenService:Create(overlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
    tweenService:Create(alertBox, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
        Position = UDim2.new(0.5, -160, 0.5, -100),
        BackgroundTransparency = 0
    }):Play()
end

local function hideAlert()
    if not isAlertOpen then return end
    
    local t1 = tweenService:Create(overlay, TweenInfo.new(0.2), {BackgroundTransparency = 1})
    local t2 = tweenService:Create(alertBox, TweenInfo.new(0.2), {
        Position = UDim2.new(0.5, -160, 0.5, -80),
        BackgroundTransparency = 1
    })
    
    t1:Play()
    t2:Play()
    
    t2.Completed:Connect(function()
        alertGui.Enabled = false
        isAlertOpen = false
    end)
end

