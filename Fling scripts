local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

header.InputBegan:Connect(function(input)
    if isAlertOpen then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    
    dragging = true
    dragStart = input.Position
    startPos = mainFrame.AbsolutePosition
    
    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            dragging = false
        end
    end)
end)

header.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    
    dragInput = input
end)

userInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input ~= dragInput then return end
    
    local currentPos = input.Position
    local delta = currentPos - dragStart
    
    local newX = startPos.X + delta.X
    local newY = startPos.Y + delta.Y
    
    local screenSize = workspace.CurrentCamera.ViewportSize
    local frameSize = mainFrame.AbsoluteSize
    
    newX = math.clamp(newX, 0, math.max(0, screenSize.X - frameSize.X))
    newY = math.clamp(newY, 0, math.max(0, screenSize.Y - frameSize.Y))
    
    mainFrame.Position = UDim2.new(0, newX, 0, newY)
end)

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    local screenSize = workspace.CurrentCamera.ViewportSize
    local frameSize = mainFrame.AbsoluteSize
    local currentPos = mainFrame.AbsolutePosition
    
    local newX = math.clamp(currentPos.X, 0, math.max(0, screenSize.X - frameSize.X))
    local newY = math.clamp(currentPos.Y, 0, math.max(0, screenSize.Y - frameSize.Y))
    
    mainFrame.Position = UDim2.new(0, newX, 0, newY)
end)

