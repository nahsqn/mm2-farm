local function getResponsiveScale()
    local viewportSize = workspace.CurrentCamera.ViewportSize
    return math.min(viewportSize.X / 1920, viewportSize.Y / 1080) * 1.3
end
local scale = getResponsiveScale()

-- ORTA POZİSYON HESAPLAMA
local function getCenterPosition(size)
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local posX = (viewportSize.X - size.X.Offset) / 2
    local posY = (viewportSize.Y - size.Y.Offset) / 2
    return UDim2.new(0, posX, 0, posY)
end

