-- TELEPORT TOOL SİSTEMİ
local tpToolRef = nil
local tpToolConnection = nil

local function createTeleportTool()
    if tpToolRef then
        pcall(function() tpToolRef:Destroy() end)
        tpToolRef = nil
    end
    if tpToolConnection then
        pcall(function() tpToolConnection:Disconnect() end)
        tpToolConnection = nil
    end
    
    local backpack = lplayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    local existing = backpack:FindFirstChild("Teleport Tool")
    if existing then existing:Destroy() end
    
    local tool = Instance.new("Tool")
    tool.Name = "Teleport Tool"
    tool.RequiresHandle = false
    tool.TextureId = "rbxassetid://103880225076501"
    tool.Parent = backpack
    
    tpToolRef = tool
    
    tpToolConnection = tool.Activated:Connect(function()
        if not states.teleport then return end
        local mouse = lplayer:GetMouse()
        local char = lplayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char:PivotTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)))
        end
    end)
    
    return tool
end

local function removeTeleportTool()
    if tpToolRef then
        pcall(function() tpToolRef:Destroy() end)
        tpToolRef = nil
    end
    if tpToolConnection then
        pcall(function() tpToolConnection:Disconnect() end)
        tpToolConnection = nil
    end
    local backpack = lplayer:FindFirstChild("Backpack")
    if backpack then
        local existing = backpack:FindFirstChild("Teleport Tool")
        if existing then existing:Destroy() end
    end
    local char = lplayer.Character
    if char then
        local hand = char:FindFirstChildOfClass("Tool")
        if hand and hand.Name == "Teleport Tool" then
            hand:Destroy()
        end
    end
end

