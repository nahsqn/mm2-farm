local function stopFollowing()
    if not targetPlayer then return end
    
    if playerRows[targetPlayer] then
        local row = playerRows[targetPlayer]
        tweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
        
        local statusDot = row:FindFirstChild("StatusDot")
        if statusDot then
            statusDot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        end
    end
    
    targetPlayer = nil
    if connection then
        connection:Disconnect()
        connection = nil
    end
    if invisiblePlatform then
        invisiblePlatform:Destroy()
        invisiblePlatform = nil
    end
    if lplayer.Character and lplayer.Character:FindFirstChild("Humanoid") then
        lplayer.Character.Humanoid.PlatformStand = false
        lplayer.Character.Humanoid.Sit = false
    end
end

local function startFollowing(target)
    stopFollowing()
    targetPlayer = target
    
    if playerRows[target] then
        local row = playerRows[target]
        tweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 40)}):Play()
        
        local statusDot = row:FindFirstChild("StatusDot")
        if statusDot then
            statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        end
    end
    
    invisiblePlatform = Instance.new("Part")
    invisiblePlatform.Name = "SafePlatform"
    invisiblePlatform.Size = Vector3.new(4, 0.5, 4)
    invisiblePlatform.Transparency = 1
    invisiblePlatform.Anchored = true
    invisiblePlatform.CanCollide = true
    invisiblePlatform.Parent = workspace
    
    connection = runService.PostSimulation:Connect(function()
        if not targetPlayer or not targetPlayer.Character or not lplayer.Character then
            stopFollowing()
            return
        end
        
        local targetChar = targetPlayer.Character
        local myChar = lplayer.Character
        
        if targetChar:FindFirstChild("HumanoidRootPart") and myChar:FindFirstChild("Humanoid") then
            local hrp = targetChar.HumanoidRootPart
            local pos = hrp.CFrame * CFrame.new(0, 3.5, 0)
            
            invisiblePlatform.CFrame = pos * CFrame.new(0, -1.5, 0)
            myChar:PivotTo(pos)
            myChar.Humanoid.Sit = true
        end
    end)
end

local function toggleFollow(target)
    if targetPlayer == target then
        stopFollowing()
    else
        startFollowing(target)
    end
end

