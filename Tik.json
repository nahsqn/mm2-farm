local function filterPlayers()
    local query = string.lower(searchBox.Text)
    for player, elements in pairs(playerButtons) do
        if query == "" then
            elements.Row.Visible = true
        else
            local nameLower = string.lower(player.Name)
            local displayLower = string.lower(player.DisplayName)
            
            if string.sub(nameLower, 1, #query) == query or string.sub(displayLower, 1, #query) == query then
                elements.Row.Visible = true
            else
                elements.Row.Visible = false
            end
        end
    end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(filterPlayers)

-- ============================================================
--  SPECTATE LOGIC
-- ============================================================
local stopSpectate, startSpectate, updateListVisuals

stopSpectate = function()
    if not spectating then return end
    spectating = false
    currentTarget = nil
    
    if cameraForceConnection then
        cameraForceConnection:Disconnect()
        cameraForceConnection = nil
    end
    
    if targetCharConnection then
        targetCharConnection:Disconnect()
        targetCharConnection = nil
    end
    
    Camera.CameraType = Enum.CameraType.Custom
    local char = LP.Character
    if char and char:FindFirstChild("Humanoid") then
        Camera.CameraSubject = char.Humanoid
    end
    
    stopBtn.Visible = false
    counterFrame.Visible = true 
    searchFrame.Visible = true
    updateListVisuals()
end

startSpectate = function(targetPlayer)
    if targetPlayer == LP then return end
    stopSpectate()
    
    local function lockCamera()
        if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = targetPlayer.Character.Humanoid
        else
            stopSpectate()
        end
    end
    
    lockCamera()
    spectating = true
    currentTarget = targetPlayer
    if not minimized then
        stopBtn.Visible = true
        counterFrame.Visible = false 
        searchFrame.Visible = false
    end
    updateListVisuals()
    
    cameraForceConnection = RunService.RenderStepped:Connect(function()
        if spectating and currentTarget == targetPlayer then
            lockCamera()
        elseif cameraForceConnection then
            cameraForceConnection:Disconnect()
            cameraForceConnection = nil
        end
    end)
    
    targetCharConnection = targetPlayer.CharacterAdded:Connect(function()
        task.wait(0.3)
        if spectating and currentTarget == targetPlayer then
            lockCamera()
        end
    end)
end

