-- ============================================================
--  MINIMIZE / MAXIMIZE 
-- ============================================================
minimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    
    if minimized then
        titleGroup.Visible = false
        closeBtn.Visible = false
        helpBtn.Visible = false
        scrollFrame.Visible = false
        stopBtn.Visible = false
        helpFrame.Visible = false
        headerFix.Visible = false
        counterFrame.Visible = false 
        searchFrame.Visible = false
        
        miniTitle.Visible = true
        minimizeBtn.Image = Icons.Maximize
        minimizeBtn.Position = UDim2.new(1, -36, 0.5, -14)
        
        TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = minimizedSize
        }):Play()
        
    else
        mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        
        minimizeBtn.Image = Icons.Minimize
        minimizeBtn.Position = UDim2.new(1, -68, 0.5, -14)
        
        local tween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = originalSize
        })
        tween:Play()
        
        tween.Completed:Connect(function()
            if not minimized then
                titleGroup.Visible = true
                closeBtn.Visible = true
                helpBtn.Visible = true
                headerFix.Visible = true
                
                if helpFrame.Visible then
                    helpFrame.Visible = true
                    scrollFrame.Visible = false
                else
                    scrollFrame.Visible = true
                    if spectating then
                        stopBtn.Visible = true
                    else
                        counterFrame.Visible = true 
                        searchFrame.Visible = true
                    end
                end
                
                miniTitle.Visible = false
            end
        end)
    end
end)

-- ============================================================
--  DRAG SYSTEM - EKRAN SINIRLI + MOBIL FIX
-- ============================================================
local activeInput = nil
local dragStart, startPos

local function updateDrag(input)
    if not activeInput then return end
    local delta = input.Position - dragStart
    local rawX = startPos.X.Offset + delta.X
    local rawY = startPos.Y.Offset + delta.Y
    
    local viewport = Camera.ViewportSize
    local absSize = mainFrame.AbsoluteSize
    
    local centerX = viewport.X/2 + rawX
    local centerY = viewport.Y/2 + rawY
    
    local halfW = absSize.X / 2
    local halfH = absSize.Y / 2
    
    centerX = math.clamp(centerX, halfW, viewport.X - halfW)
    centerY = math.clamp(centerY, halfH, viewport.Y - halfH)
    
    mainFrame.Position = UDim2.new(0.5, centerX - viewport.X/2, 0.5, centerY - viewport.Y/2)
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        activeInput = input
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == activeInput then
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateDrag(input)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == activeInput then
        activeInput = nil
    end
end)

-- ============================================================
--  PLAYER LIST
-- ============================================================
updateListVisuals = function()
    for player, elements in pairs(playerButtons) do
        if player == currentTarget then
            elements.Row.BackgroundColor3 = Theme.Accent
            elements.SpecBtn.Text = translate("İzleniyor")
            elements.SpecBtn.BackgroundColor3 = Theme.Error
        else
            elements.Row.BackgroundColor3 = Theme.Surface
            elements.SpecBtn.Text = translate("İzle")
            elements.SpecBtn.BackgroundColor3 = Theme.Accent
        end
    end
end

local function createPlayerRow(player)
    if player == LP then return end
    
    local row = Instance.new("Frame")
    row.Name = player.Name .. "_Row"
    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundColor3 = Theme.Surface
    row.BackgroundTransparency = 0.2
    row.BorderSizePixel = 0
    row.ZIndex = 52
    row.LayoutOrder = player.Name:byte(1)
    
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)
    
    local avatar = Instance.new("ImageLabel")
    avatar.Size = UDim2.new(0, 28, 0, 28)
    avatar.Position = UDim2.new(0, 6, 0.5, -14)
    avatar.BackgroundColor3 = Theme.SurfaceHover
    avatar.BorderSizePixel = 0
    avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150"
    avatar.ZIndex = 53
    avatar.Parent = row
    
    Instance.new("UICorner", avatar).CornerRadius = UDim.new(0, 6)
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -140, 0, 18)
    nameLabel.Position = UDim2.new(0, 40, 0, 3)
    nameLabel.Text = player.DisplayName ~= player.Name and (player.DisplayName .. " (@" .. player.Name .. ")") or player.Name
    nameLabel.TextColor3 = Theme.TextPrimary
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.ZIndex = 53
    nameLabel.Parent = row
    
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -140, 0, 14)
    statusLabel.Position = UDim2.new(0, 40, 0, 21)
    statusLabel.Text = translate("Canlı")
    statusLabel.TextColor3 = Theme.Success
    statusLabel.TextSize = 10
    statusLabel.Font = Enum.Font.GothamMedium
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.ZIndex = 53
    statusLabel.Parent = row
    
    local specBtn = Instance.new("TextButton")
    specBtn.Name = "SpectateBtn"
    specBtn.Size = UDim2.new(0, 80, 0, 26)
    specBtn.Position = UDim2.new(1, -86, 0.5, -13)
    specBtn.Text = translate("İzle")
    specBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    specBtn.TextSize = 11
    specBtn.Font = Enum.Font.GothamBold
    specBtn.BackgroundColor3 = Theme.Accent
    specBtn.BackgroundTransparency = 0.2
    specBtn.BorderSizePixel = 0
    specBtn.AutoButtonColor = false
    specBtn.ZIndex = 53
    specBtn.Parent = row
    
    Instance.new("UICorner", specBtn).CornerRadius = UDim.new(0, 6)
    
    row.MouseEnter:Connect(function()
        if currentTarget ~= player then
            TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Theme.SurfaceHover}):Play()
        end
    end)
    row.MouseLeave:Connect(function()
        if currentTarget ~= player then
            TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Surface}):Play()
        end
    end)
    
    specBtn.MouseEnter:Connect(function()
        TweenService:Create(specBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    end)
    specBtn.MouseLeave:Connect(function()
        TweenService:Create(specBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    end)
    
    specBtn.MouseButton1Click:Connect(function()
        startSpectate(player)
    end)
    
    playerButtons[player] = {
        Row = row,
        StatusLabel = statusLabel,
        SpecBtn = specBtn
    }
    
    row.Parent = scrollFrame
    
    local function updateStatus()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            if player.Character.Humanoid.Health > 0 then
                statusLabel.Text = translate("Canlı")
                statusLabel.TextColor3 = Theme.Success
                specBtn.Visible = true
            else
                statusLabel.Text = translate("Ölü")
                statusLabel.TextColor3 = Theme.Error
                specBtn.Visible = false
                if currentTarget == player then
                    stopSpectate()
                end
            end
        else
            statusLabel.Text = translate("Yükleniyor...")
            statusLabel.TextColor3 = Theme.TextSecondary 
            specBtn.Visible = false
        end
    end
    
    if player.Character then
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:GetPropertyChangedSignal("Health"):Connect(updateStatus)
        end
    end
    
    player.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid then
            humanoid:GetPropertyChangedSignal("Health"):Connect(updateStatus)
            updateStatus()
        end
    end)
    
    player.CharacterRemoving:Connect(updateStatus)
    updateStatus()
    
    filterPlayers()
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LP then
        createPlayerRow(player)
    end
end

Players.PlayerAdded:Connect(createPlayerRow)

Players.PlayerRemoving:Connect(function(player)
    if playerButtons[player] then
        playerButtons[player].Row:Destroy()
        playerButtons[player] = nil
    end
    if currentTarget == player then
        stopSpectate()
    end
end)

