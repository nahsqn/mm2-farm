local translator = nil
local function initTranslator()
    -- Oyuncunun deneyim dili tercihini (RobloxLocaleId) alıyoruz
    local success, result = pcall(function()
        return LocalizationService:GetTranslatorForPlayerAsync(LP)
    end)
    if success and result then
        translator = result
    else
        -- Hata durumunda oyunun varsayılan yerelleştirmesini dene
        pcall(function()
            translator = LocalizationService:GetTranslatorForLocaleAsync(LocalizationService.RobloxLocaleId)
        end)
    end
end
initTranslator()

-- Çeviri yardımcı fonksiyonu (Deneyim dilinde karşılık bulamazsa orijinal metni yazar)
local function translate(text)
    if translator then
        local success, translatedText = pcall(function()
            return translator:Translate(game, text)
        end)
        if success and translatedText then
            return translatedText
        end
    end
    return text
end

