    switchBg.Name = "Switch"
    switchBg.Size = UDim2.new(0, 51, 0, 31)
    switchBg.Position = UDim2.new(1, -66, 0.5, -15)
    switchBg.BackgroundColor3 = Color3.fromRGB(120, 120, 128)
