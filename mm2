local function applyGunESP(obj)
    if obj.Name == "GunDrop" and obj:IsA("BasePart") then
        local hl = obj:FindFirstChild("GunHighlight") or Instance.new("Highlight", obj)
        hl.Name = "GunHighlight"
        hl.FillColor = Color3.fromRGB(255, 255, 0)
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.Enabled = states.gunESP
        
        local tag = obj:FindFirstChild("GunTag") or Instance.new("BillboardGui", obj)
        if tag.Name ~= "GunTag" then
            tag.Name = "GunTag"
            tag.Size = UDim2.new(0, 50, 0, 50)
            tag.AlwaysOnTop = true
            tag.StudsOffset = Vector3.new(0, 1.5, 0)
            local label = Instance.new("TextLabel", tag)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "🔫"
            label.TextSize = 25
        end
        tag.Enabled = states.gunESP
    end
end

