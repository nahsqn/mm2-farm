-- TELEPORT TOOL SİSTEMİ
local tpToolRef = nil
local tpToolConnection = nil

local function createTeleportTool()
    if tpToolRef then
        pcall(function() tpToolRef:Destroy() end)
        tpToolRef = nil
    end
    if tpToolConnection then
        pcall(function() tpToolConnection:Disconnect() end)
        tpToolConnection = nil
    end
    
    local backpack = lplayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    local existing = backpack:FindFirstChild("Teleport Tool")
    if existing then existing:Destroy() end
    
    local tool = Instance.new("Tool")
    tool.Name = "Teleport Tool"
    tool.RequiresHandle = false
    tool.TextureId = "rbxassetid://6034287525"
    tool.Parent = backpack
    
    tpToolRef = tool
    
    tpToolConnection = tool.Activated:Connect(function()
        if not states.teleport then return end
        local mouse = lplayer:GetMouse()
        local char = lplayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char:PivotTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)))
        end
    end)
    
    return tool
end

local function removeTeleportTool()
    states.teleport = false
    if tpToolRef then
        pcall(function() tpToolRef:Destroy() end)
        tpToolRef = nil
    end
    if tpToolConnection then
        pcall(function() tpToolConnection:Disconnect() end)
        tpToolConnection = nil
    end
    local backpack = lplayer:FindFirstChild("Backpack")
    if backpack then
        local existing = backpack:FindFirstChild("Teleport Tool")
        if existing then existing:Destroy() end
    end
    local char = lplayer.Character
    if char then
        local hand = char:FindFirstChildOfClass("Tool")
        if hand and hand.Name == "Teleport Tool" then
            hand:Destroy()
        end
    end
end

-- ANTI-FLING SİSTEMİ
local antiFlingConnection = nil
local antiFlingBodyPos = nil
local antiFlingBodyGyro = nil

local function enableAntiFling()
    local char = lplayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Mevcut body position/gyro varsa temizle
    if antiFlingBodyPos then antiFlingBodyPos:Destroy() end
    if antiFlingBodyGyro then antiFlingBodyGyro:Destroy() end
    
    -- BodyPosition ile pozisyonu sabitle (sadece Y ekseni için yumuşak sabitleme)
    antiFlingBodyPos = Instance.new("BodyPosition")
    antiFlingBodyPos.Name = "AntiFlingBP"
    antiFlingBodyPos.MaxForce = Vector3.new(0, math.huge, 0) -- Sadece dikey
    antiFlingBodyPos.Position = root.Position
    antiFlingBodyPos.D = 500 -- Damping
    antiFlingBodyPos.P = 5000 -- Power
    antiFlingBodyPos.Parent = root
    
    -- BodyGyro ile rotasyonu sabitle
    antiFlingBodyGyro = Instance.new("BodyGyro")
    antiFlingBodyGyro.Name = "AntiFlingBG"
    antiFlingBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    antiFlingBodyGyro.CFrame = root.CFrame
    antiFlingBodyGyro.D = 100
    antiFlingBodyGyro.P = 10000
    antiFlingBodyGyro.Parent = root
    
    -- Her frame pozisyonu güncelle (sadece çok hızlı hareketlerde müdahale)
    antiFlingConnection = runService.Heartbeat:Connect(function()
        if not states.antiFling then return end
        if not lplayer.Character then return end
        local currentRoot = lplayer.Character:FindFirstChild("HumanoidRootPart")
        if not currentRoot then return end
        
        -- Çok hızlı hareket varsa (fling) pozisyonu sıfırla
        local velocity = currentRoot.Velocity
        if velocity.Magnitude > 150 then -- Fling tespiti
            currentRoot.Velocity = Vector3.new(0, 0, 0)
            currentRoot.RotVelocity = Vector3.new(0, 0, 0)
            if antiFlingBodyPos then
                antiFlingBodyPos.Position = currentRoot.Position - Vector3.new(0, 5, 0)
            end
        end
        
        -- BodyPosition'u güncelle (yumuşak takip)
        if antiFlingBodyPos then
            antiFlingBodyPos.Position = currentRoot.Position
        end
        if antiFlingBodyGyro then
            antiFlingBodyGyro.CFrame = currentRoot.CFrame
        end
    end)
end

local function disableAntiFling()
    states.antiFling = false
    if antiFlingConnection then
        antiFlingConnection:Disconnect()
        antiFlingConnection = nil
    end
    if antiFlingBodyPos then
        antiFlingBodyPos:Destroy()
        antiFlingBodyPos = nil
    end
    if antiFlingBodyGyro then
        antiFlingBodyGyro:Destroy()
        antiFlingBodyGyro = nil
    end
end

-- ESP AYARLARI
local specialUserId = 5177153749

local function getPlayerStatus(p)
    local character = p.Character
    local backpack = p:FindFirstChild("Backpack")
    
    local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or (character and character:FindFirstChild("Knife"))
    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or (character and character:FindFirstChild("Gun"))
    
    local color = Color3.fromRGB(0, 255, 0)
    local icon = ""
    
    if p.UserId == specialUserId then
        color = Color3.fromRGB(255, 0, 255)
    elseif hasKnife then
        color = Color3.fromRGB(255, 0, 0)
    elseif hasGun then
        color = Color3.fromRGB(0, 150, 255)
    end
    
    if hasKnife then icon = "🔪" end
    if hasGun then icon = "🔫" end
    if hasKnife and hasGun then icon = "🔪🔫" end
    
    return color, icon
end

