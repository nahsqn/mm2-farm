    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle
    
    local glow = Instance.new("ImageLabel")
    glow.Name = "Glow"
    glow.Size = UDim2.new(1.5, 0, 1.5, 0)
    glow.Position = UDim2.new(-0.25, 0, -0.25, 0)
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://5028857084"
    glow.ImageColor3 = Color3.fromRGB(255, 255, 255)
    glow.ImageTransparency = 1
    glow.Parent = circle
    
    circle.Parent = switchBg
    switchBg.Parent = container
    
    local isOn = false
    local function toggle()
        isOn = not isOn
        
        local targetColor = isOn and Color3.fromRGB(48, 209, 88) or Color3.fromRGB(120, 120, 128)
        local targetPos = isOn and UDim2.new(1, -29, 0.5, -13) or UDim2.new(0, 2, 0.5, -13)
        
        tweenService:Create(switchBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            BackgroundColor3 = targetColor
        }):Play()
        
        tweenService:Create(circle, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Position = targetPos
        }):Play()
        
        if isOn then
            tweenService:Create(glow, TweenInfo.new(0.2), {ImageTransparency = 0.8}):Play()
        else
            tweenService:Create(glow, TweenInfo.new(0.2), {ImageTransparency = 1}):Play()
        end
        
        callback(isOn)
    end
    
    switchBg.MouseButton1Click:Connect(toggle)
    
    return container, toggle
end

