    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(1, 0, 0, 2 * scale)
    progressBar.Position = UDim2.new(0, 0, 1, -2 * scale)
    progressBar.BackgroundColor3 = accentColor
