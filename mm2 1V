RS.Heartbeat:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root then return end

    if states.platform and platform.Parent then
        platform.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.2, root.Position.Z)
    end

    if states.noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "AdminPlatform" then
                part.CanCollide = false
            end
        end
    end

    if states.fly then
        local bg = root:FindFirstChild("FlyBG") or Instance.new("BodyGyro")
        local bv = root:FindFirstChild("FlyBV") or Instance.new("BodyVelocity")

        if not root:FindFirstChild("FlyBG") then
            bg.Name = "FlyBG"
            bg.P = 9e4
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.CFrame = root.CFrame
            bg.Parent = root
        end

        if not root:FindFirstChild("FlyBV") then
            bv.Name = "FlyBV"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = root
        end

        local cam = workspace.CurrentCamera
        bg.CFrame = cam.CFrame

        local moveDir = Vector3.new(0, 0, 0)
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        bv.Velocity = moveDir * 50
    else
        if root:FindFirstChild("FlyBG") then root.FlyBG:Destroy() end
        if root:FindFirstChild("FlyBV") then root.FlyBV:Destroy() end
    end
end)

