local function createSidebarTab(name)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Tab"
    btn.Size = UDim2.new(0, 52 * scale, 0, 52 * scale)
    btn.Text = ""
    btn.BackgroundColor3 = (name == currentTab) and Theme.Accent or Theme.Surface
    btn.BackgroundTransparency = (name == currentTab) and 0 or 0.5
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.ZIndex = 102
    btn.Parent = sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 14 * scale)
    btnCorner.Parent = btn

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 24 * scale, 0, 24 * scale)
    icon.Position = UDim2.new(0.5, -12 * scale, 0.5, -12 * scale)
    icon.BackgroundTransparency = 1
    icon.Image = tabIcons[name] or "rbxassetid://6031071053"
    icon.ImageColor3 = (name == currentTab) and Color3.fromRGB(255,255,255) or Theme.TextSecondary
    icon.ZIndex = 103
    icon.Parent = btn

    local tooltip = Instance.new("TextLabel")
    tooltip.Size = UDim2.new(0, 80 * scale, 0, 26 * scale)
    tooltip.Position = UDim2.new(1, 10 * scale, 0.5, -13 * scale)
    tooltip.Text = name
    tooltip.TextColor3 = Theme.TextPrimary
    tooltip.TextSize = 11 * scale
    tooltip.Font = Enum.Font.GothamBold
    tooltip.BackgroundColor3 = Theme.Surface
    tooltip.BackgroundTransparency = 0.1
    tooltip.BorderSizePixel = 0
    tooltip.TextXAlignment = Enum.TextXAlignment.Center
    tooltip.ZIndex = 105
    tooltip.Visible = false
    tooltip.Parent = btn

    local tooltipCorner = Instance.new("UICorner")
    tooltipCorner.CornerRadius = UDim.new(0, 8 * scale)
    tooltipCorner.Parent = tooltip

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3 * scale, 0, 28 * scale)
    indicator.Position = UDim2.new(0, -2 * scale, 0.5, -14 * scale)
    indicator.BackgroundColor3 = Theme.AccentLight
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 103
    indicator.Visible = (name == currentTab)
    indicator.Parent = btn

    local indicatorCorner = Instance.new("UICorner")
    indicatorCorner.CornerRadius = UDim.new(0, 2 * scale)
    indicatorCorner.Parent = indicator

    btn.MouseEnter:Connect(function()
        if name ~= currentTab then
            TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.SurfaceHover}):Play()
        end
        tooltip.Visible = true
    end)

    btn.MouseLeave:Connect(function()
        if name ~= currentTab then
            TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Surface}):Play()
        end
        tooltip.Visible = false
    end)

    tabs[name] = {Button = btn, Icon = icon, Indicator = indicator}
    return btn
end

