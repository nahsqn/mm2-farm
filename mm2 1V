-- Tool bul ve al
local function autoEquipKnife()
    local char = lplayer.Character
    local backpack = lplayer:FindFirstChild("Backpack")
    local humanoid = char and char:FindFirstChild("Humanoid")
    
    if not char or not backpack or not humanoid then return nil end
    
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(killAuraConfig.TOOL_NAME:lower()) then
            return tool
        end
    end
    
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(killAuraConfig.TOOL_NAME:lower()) then
            humanoid:EquipTool(tool)
            task.wait(killAuraConfig.EQUIP_DELAY)
            return tool
        end
    end
    return nil
end

-- Gun tool'u olan oyuncuyu bul
local function findGunPlayer()
    local char = lplayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local myPos = hrp.Position
    local closestPlayer = nil
    local closestDistance = killAuraConfig.Q_RANGE
    
    for _, plr in pairs(players:GetPlayers()) do
        if plr ~= lplayer and plr.Character then
            local targetChar = plr.Character
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar:FindFirstChild("Humanoid")
            
            if targetHrp and targetHum and targetHum.Health > 0 then
                local distance = (targetHrp.Position - myPos).Magnitude
                
                if distance <= killAuraConfig.Q_RANGE and distance < closestDistance then
                    local hasGun = false
                    
                    -- Elinde kontrol et
                    for _, obj in pairs(targetChar:GetChildren()) do
                        if obj:IsA("Tool") and obj.Name:lower():find(killAuraConfig.TARGET_TOOL:lower()) then
                            hasGun = true
                            break
                        end
                    end
                    
                    -- Backpack'te kontrol et
                    if not hasGun then
                        local plrBackpack = plr:FindFirstChild("Backpack")
                        if plrBackpack then
                            for _, obj in pairs(plrBackpack:GetChildren()) do
                                if obj:IsA("Tool") and obj.Name:lower():find(killAuraConfig.TARGET_TOOL:lower()) then
                                    hasGun = true
                                    break
                                end
                            end
                        end
                    end
                    
                    if hasGun then
                        closestDistance = distance
                        closestPlayer = plr
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

-- TEK SEFERDE ÖLDÜR
local function oneShotKill(targetHrp, targetHumanoid, knife)
    -- Hedefe dön
    local char = lplayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    hrp.CFrame = CFrame.new(hrp.Position, targetHrp.Position)
    task.wait(0.05)
    
    -- Tüm öldürme yöntemlerini aynı anda dene
    task.spawn(function()
        -- Yöntem 1: Activate
        pcall(function()
            if knife.Enabled then
                knife:Activate()
            end
        end)
        
        -- Yöntem 2: Tüm RemoteEvent'leri dene
        for _, obj in pairs(knife:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                pcall(function()
                    obj:FireServer(targetHrp.Position)
                    obj:FireServer(targetHrp)
                    obj:FireServer(targetHumanoid)
                    obj:FireServer()
                end)
            elseif obj:IsA("RemoteFunction") then
                pcall(function()
                    obj:InvokeServer(targetHrp.Position)
                end)
            end
        end
        
        -- Yöntem 3: MouseClick event
        local clickEvent = knife:FindFirstChild("MouseClick") or 
                          knife:FindFirstChild("ClickEvent") or
                          knife:FindFirstChild("HitEvent")
        if clickEvent then
            pcall(function()
                clickEvent:FireServer(targetHrp.Position)
            end)
        end
        
        -- Yöntem 4: Tool'un PrimaryPart'ına dokunma simülasyonu
        pcall(function()
            local toolHandle = knife:FindFirstChild("Handle") or knife:FindFirstChildOfClass("Part")
            if toolHandle then
                toolHandle.CFrame = targetHrp.CFrame
            end
        end)
    end)
    
    -- Eğer tek vuruş yetmezse 3 defa daha dene
    if killAuraConfig.ONE_SHOT then
        for i = 1, 3 do
            task.wait(0.1)
            task.spawn(function()
                pcall(function()
                    if knife.Enabled then knife:Activate() end
                end)
            end)
        end
    end
end

-- Q ANA FONKSİYONU (Gun Kill)
local function qGunKill()
    if isOnCooldownQ then
        showiOSNotification("⏳ Cooldown", "Q bekleme süresinde!", 2, "rbxassetid://6034281908")
        return
    end
    
    local char = lplayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Gun hedefi bul
    local target = findGunPlayer()
    if not target then
        showiOSNotification("❌ Hedef Yok", "Gun tool'u olan kimse yok!", 2, "rbxassetid://6034281908")
        return
    end
    
    -- Knife al
    local knife = autoEquipKnife()
    if not knife then
        showiOSNotification("🔪 Knife Yok", "Knife bulunamadı!", 2, "rbxassetid://6034281908")
        return
    end
    
    isOnCooldownQ = true
    
    local targetChar = target.Character
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar:FindFirstChild("Humanoid")
    
    if not targetHrp or not targetHum then
        isOnCooldownQ = false
        return
    end
    
    showiOSNotification("🎯 Q Hedef", target.Name .. " bulundu!", 2, "rbxassetid://6034287518")
    
    -- YANINA ÇEK (Direkt dibine)
    local myCFrame = hrp.CFrame
    local targetPos = myCFrame.Position + (myCFrame.LookVector * killAuraConfig.Q_PULL_DISTANCE)
    
    targetHrp.CFrame = CFrame.new(targetPos, myCFrame.Position)
    targetHrp.Velocity = Vector3.new(0, 0, 0)
    targetHrp.RotVelocity = Vector3.new(0, 0, 0)
    
    -- Stun (kısa süreli)
    targetHum.WalkSpeed = 0
    targetHum.JumpPower = 0
    targetHum.PlatformStand = true
    
    showiOSNotification("⚡ Çekildi", target.Name .. " yanına çekildi!", 2, "rbxassetid://6034287518")
    
    -- TEK SEFERDE ÖLDÜR
    oneShotKill(targetHrp, targetHum, knife)
    
    -- Temizlik
    task.delay(1, function()
        if targetHum and targetHum.Parent then
            targetHum.WalkSpeed = 16
            targetHum.JumpPower = 50
            targetHum.PlatformStand = false
        end
        
        showiOSNotification("💀 Öldürüldü", target.Name .. " kesildi!", 2, "rbxassetid://6034287518")
    end)
    
    -- Cooldown
    task.delay(killAuraConfig.Q_COOLDOWN, function()
        isOnCooldownQ = false
        showiOSNotification("✅ Hazır", "Q tekrar kullanılabilir!", 2, "rbxassetid://6034287518")
    end)
end

-- KILL AURA (Otomatik yakındakileri öldür)
local function enableKillAura()
    if killAuraConnection then
        pcall(function() killAuraConnection:Disconnect() end)
        killAuraConnection = nil
    end
    
    killAuraConnection = runService.Heartbeat:Connect(function()
        if not states.killAura then return end
        
        local char = lplayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        if not hrp or not humanoid then return end
        
        local knife = autoEquipKnife()
        if not knife then return end
        
        for _, plr in pairs(players:GetPlayers()) do
            if plr ~= lplayer and plr.Character then
                local targetChar = plr.Character
                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                local targetHum = targetChar:FindFirstChild("Humanoid")
                
                if targetHrp and targetHum and targetHum.Health > 0 then
                    local distance = (targetHrp.Position - hrp.Position).Magnitude
                    
                    if distance <= killAuraConfig.KILL_RANGE then
                        -- Otomatik öldür
                        pcall(function()
                            hrp.CFrame = CFrame.new(hrp.Position, targetHrp.Position)
                            if knife.Enabled then
                                knife:Activate()
                            end
                        end)
                    end
                end
            end
        end
    end)
    
    showiOSNotification("⚔️ Kill Aura", "Otomatik öldürme aktif! Menzil: " .. killAuraConfig.KILL_RANGE, 2, "rbxassetid://6034287518")
end

local function disableKillAura()
    if killAuraConnection then
