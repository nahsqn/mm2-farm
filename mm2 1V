local function findMurderer()
    for _, i in ipairs(Players:GetPlayers()) do
        if i.Backpack:FindFirstChild("Knife") then return i end
    end
    for _, i in ipairs(Players:GetPlayers()) do
        if not i.Character then continue end
        if i.Character:FindFirstChild("Knife") then return i end
    end
    return nil
end

local function findSheriffThatsNotMe()
    for _, i in ipairs(Players:GetPlayers()) do
        if i == LP then continue end
        if i.Backpack:FindFirstChild("Gun") then return i end
    end
    for _, i in ipairs(Players:GetPlayers()) do
        if i == LP then continue end
        if not i.Character then continue end
        if i.Character:FindFirstChild("Gun") then return i end
    end
    return nil
end

local function getPredictedPosition(player, offset)
    local character = player.Character
    if not character then return Vector3.new() end
    local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
    local hum = character:FindFirstChild("Humanoid")
    if not hrp or not hum then return hrp and hrp.Position or Vector3.new() end
    local velocity = hrp.AssemblyLinearVelocity
    local moveDir = hum.MoveDirection
    local predicted = hrp.Position + (velocity * Vector3.new(0.75, 0.5, 0.75)) * (offset / 15) + moveDir * offset
    predicted *= (((LP:GetNetworkPing() * 1000) * ((combatConfig.offsetToPingMult - 1) * 0.01)) + 1)
    return predicted
end

local function shootMurderer()
    local character = LP.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    local gunInBackpack = LP.Backpack:FindFirstChild("Gun")
    local gunInCharacter = character:FindFirstChild("Gun")
    if not gunInBackpack and not gunInCharacter then
        showNotification("No Gun", "Gun not found!", 2, "rbxassetid://6034281908", "error")
        return
    end
    if gunInBackpack then
        humanoid:EquipTool(gunInBackpack)
        task.wait(combatConfig.equipWaitTime)
        gunInCharacter = character:FindFirstChild("Gun")
        if not gunInCharacter then
            showNotification("Error", "Failed to equip gun!", 2, "rbxassetid://6034281908", "error")
            return
        end
    end
    local target = findMurderer() or findSheriffThatsNotMe()
    if not target or not target.Character then
        showNotification("No Target", "Murderer or Sheriff not found!", 2, "rbxassetid://6034281908", "error")
        return
    end
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end
    local predictedPosition = getPredictedPosition(target, combatConfig.shootOffset)
    local success = false
    local knifeLocal = gunInCharacter:FindFirstChild("KnifeLocal")
    if knifeLocal then
        local createBeam = knifeLocal:FindFirstChild("CreateBeam")
        if createBeam then
            local rf = createBeam:FindFirstChildWhichIsA("RemoteFunction")
            if rf then
                rf:InvokeServer(1, predictedPosition, "AH2")
                success = true
            end
        end
    end
    if not success then
        local shootEvent = gunInCharacter:FindFirstChild("Shoot")
        if shootEvent and shootEvent:IsA("RemoteEvent") then
            shootEvent:FireServer(CFrame.new(character.RightHand.Position), CFrame.new(predictedPosition))
            success = true
        end
    end
    if success then
        showNotification("Shot Fired", target.Name .. " hit!", 2, "rbxassetid://6034287518", "success")
    else
        showNotification("Error", "Shoot method not found!", 2, "rbxassetid://6034281908", "error")
    end
end

local function enableAutoShoot()
    if autoShootConnection then return end
    autoShootConnection = RS.Heartbeat:Connect(function()
        if not states.autoShoot then return end
        local char = LP.Character
        if not char then return end
        if not char:FindFirstChild("Gun") then return end
        local target = findMurderer()
        if not target or not target.Character then return end
        local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
        local myHRP = char:FindFirstChild("HumanoidRootPart")
        if not targetHRP or not myHRP then return end
        local distance = (targetHRP.Position - myHRP.Position).Magnitude
        if distance <= combatConfig.autoShootRange then shootMurderer() end
    end)
    showNotification("Auto Shoot", "Auto fire active! Range: " .. combatConfig.autoShootRange, 2, "rbxassetid://6034287518", "success")
end

