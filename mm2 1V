-- Ana Işınlanma Efekt Fonksiyonu (Ses, Çizgi ve Patlama)
local function playTeleportEffect(startPos, endPos)
    ---------------------------------------------------------
    -- 1. BÖLÜM: YEREL EFEKTLER (SES VE PARTİKÜL PATLAMASI) --
    -- Bu fonksiyonu hem başlangıç hem bitiş için ayrı ayrı çağırmak yerine
    -- kodu temizlemek için içeride bir yardımcı fonksiyon oluşturuyoruz.
    ---------------------------------------------------------
    local function spawnLocalEffects(pos)
        local effectPart = Instance.new("Part")
        effectPart.Size = Vector3.new(1, 1, 1)
        effectPart.CFrame = CFrame.new(pos)
        effectPart.Anchored = true
        effectPart.CanCollide = false
        effectPart.Transparency = 1 
        effectPart.Parent = workspace

        -- Rastgele Ses Çalma
        local sound = Instance.new("Sound")
        sound.SoundId = teleportSounds[math.random(1, #teleportSounds)]
        sound.Volume = 1
        sound.Parent = effectPart
        sound:Play()
        
        -- Mor Partikül Patlaması (Daire/Glow)
        local particles = Instance.new("ParticleEmitter")
        particles.Texture = "rbxassetid://242967252" 
        particles.Color = ColorSequence.new(Color3.fromRGB(163, 41, 239)) 
        particles.Size = NumberSequence.new(0.7, 0)
        particles.Lifetime = NumberRange.new(0.5, 0.8)
        particles.Speed = NumberRange.new(5, 12)
        particles.SpreadAngle = Vector2.new(360, 360)
        particles.Parent = effectPart
        particles:Emit(40)
        
        -- Efekt parçasını sil
        Debris:AddItem(effectPart, 2)
    end

    ---------------------------------------------------------
    -- 2. BÖLÜM: MOR ÇİZGİ (BEAM) EFEKTİ (ARKADA KALAN İZ) --
    ---------------------------------------------------------
    
    -- Işının tutunacağı görünmez parçalar
    local beamPart = Instance.new("Part")
    beamPart.Name = "TeleportTrail"
    beamPart.Size = Vector3.new(1, 1, 1)
    beamPart.Anchored = true
    beamPart.CanCollide = false
    beamPart.Transparency = 1
    beamPart.Parent = workspace

    local attachStart = Instance.new("Attachment")
    attachStart.Position = startPos
    attachStart.Parent = beamPart

    local attachEnd = Instance.new("Attachment")
    attachEnd.Position = endPos
    attachEnd.Parent = beamPart

    -- Işın (Beam) Oluşturma
    local beam = Instance.new("Beam")
    beam.Attachment0 = attachStart
    beam.Attachment1 = attachEnd
    
    -- Işın Görünüm Ayarları
    beam.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(163, 41, 239)), -- Başlangıç Mor
        ColorSequenceKeypoint.new(1, Color3.fromRGB(85, 0, 127))    -- Bitiş Koyu Mor
    })
    
    -- Işın şerit gibi görünsün (Kalınlık)
    beam.Width0 = 1.5 -- Başlangıç kalınlığı
    beam.Width1 = 0.2 -- Bitiş kalınlığı (İncelerek gitsin)
    
    -- Varsayılan düz beyaz doku (Pürüzsüz çizgi için en iyisi)
    beam.Texture = "rbxassetid://13511849141" 
    beam.TextureMode = Enum.TextureMode.Wrap
    beam.TextureSpeed = 0 -- Çizgi hareket etmesin, sabit kalsın
    
    beam.LightEmission = 1 -- Parlasın
    beam.FaceCamera = true -- Her zaman kameraya baksın
    beam.Transparency = NumberSequence.new(0) -- Tam görünür başlasın
    
    beam.Parent = beamPart

    -- 3. BÖLÜM: EFEKTLERİ TETİKLE VE TEMİZLE
    
    -- Başlangıç ve bitişte patlama efektlerini oluştur
    spawnLocalEffects(startPos)
    spawnLocalEffects(endPos)
    
    -- Çizginin yavaşça kaybolmasını sağla (TweenService kullanmadan basitçe)
    task.spawn(function()
        local duration = 0.8 -- Çizginin görünme süresi
        local steps = 10
        for i = 1, steps do
            task.wait(duration / steps)
            if beam and beam.Parent then
                -- Şeffaflığı artır
                local trans = i / steps
                beam.Transparency = NumberSequence.new(trans)
                -- Yavaşça incelt
                beam.Width0 = 1.5 * (1 - trans)
            end
        end
        -- Sonunda temizle
        beamPart:Destroy()
    end)
end

local function createTeleportTool()
    -- Mevcut aracı temizle
    if tpToolRef then pcall(function() tpToolRef:Destroy() end) tpToolRef = nil end
    if tpToolConnection then pcall(function() tpToolConnection:Disconnect() end) tpToolConnection = nil end
    
    -- LP kontrolü (Yerel oyuncu)
    local localPlayer = LP or Players.LocalPlayer
    if not localPlayer then return end
    
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    local tool = Instance.new("Tool")
    tool.Name = "Teleport Tool"
    tool.RequiresHandle = false
    tool.TextureId = "rbxassetid://117907642459033"
    tool.Parent = backpack
    tpToolRef = tool
    
    tpToolConnection = tool.Activated:Connect(function()
        -- states.teleport kontrolü
        if not states or (states and not states.teleport) then return end
        
        local mouse = localPlayer:GetMouse()
