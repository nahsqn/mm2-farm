local function switchTab(newTab)
    if newTab == currentTab then return end
    
    local oldBtn = tabs[currentTab]
    tweenService:Create(oldBtn, TweenInfo.new(0.3), {
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        TextColor3 = Color3.fromRGB(120, 120, 130)
    }):Play()
    
    tabContents[currentTab].Visible = false
    
    currentTab = newTab
    local newBtn = tabs[newTab]
    tweenService:Create(newBtn, TweenInfo.new(0.3), {
        BackgroundColor3 = Color3.fromRGB(80, 70, 230),
        TextColor3 = Color3.fromRGB(255, 255, 255)
    }):Play()
    
    tabContents[newTab].Visible = true
end

