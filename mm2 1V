-- Switch tab function
local function switchTab(newTab)
    if newTab == currentTab then return end

    local oldData = tabs[currentTab]
    TS:Create(oldData.Button, TweenInfo.new(0.3), {
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.5
    }):Play()
    TS:Create(oldData.Icon, TweenInfo.new(0.3), {
        ImageColor3 = Theme.TextSecondary
    }):Play()
    oldData.Indicator.Visible = false

    for _, child in pairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    currentTab = newTab

    local newData = tabs[newTab]
    TS:Create(newData.Button, TweenInfo.new(0.3), {
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0
    }):Play()
    TS:Create(newData.Icon, TweenInfo.new(0.3), {
        ImageColor3 = Color3.fromRGB(255, 255, 255)
    }):Play()
    newData.Indicator.Visible = true

    contentTitle.Text = newTab

    rebuildTabContent(newTab)
end

