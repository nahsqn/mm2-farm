            char:PivotTo(CFrame.new(targetPosition))
        end
    end)
end


-- Anti-Fling
local function PlayerAdded(Player)
    if not antiFlingEnabled then return end
    local Detected = false
    local Character
    local PrimaryPart
    local function CharacterAdded(NewCharacter)
        Character = NewCharacter
        repeat task.wait() PrimaryPart = NewCharacter:FindFirstChild("HumanoidRootPart") until PrimaryPart
        Detected = false
    end
    CharacterAdded(Player.Character or Player.CharacterAdded:Wait())
    local charConnection = Player.CharacterAdded:Connect(CharacterAdded)
    table.insert(antiFlingConnections, charConnection)
    local heartbeatConnection = RS.Heartbeat:Connect(function()
        if not antiFlingEnabled then return end
        if (Character and Character:IsDescendantOf(workspace)) and (PrimaryPart and PrimaryPart:IsDescendantOf(Character)) then
            if PrimaryPart.AssemblyAngularVelocity.Magnitude > 50 or PrimaryPart.AssemblyLinearVelocity.Magnitude > 100 then
                if Detected == false then
                    showNotification("Fling Detected", "Player: " .. tostring(Player.Name), 3, "rbxassetid://6034281908", "warning")
                end
                Detected = true
                for i,v in ipairs(Character:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = false
                        v.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        v.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        v.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0)
                    end
                end
                PrimaryPart.CanCollide = false
                PrimaryPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                PrimaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                PrimaryPart.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0)
            end
        end
    end)
    table.insert(antiFlingConnections, heartbeatConnection)
end

local function enableAntiFling()
    if antiFlingEnabled then return end
    antiFlingEnabled = true
    for i,v in ipairs(Players:GetPlayers()) do
        if v ~= LP then PlayerAdded(v) end
    end
    local playerAddedConnection = Players.PlayerAdded:Connect(PlayerAdded)
    table.insert(antiFlingConnections, playerAddedConnection)
    local localHeartbeat = RS.Heartbeat:Connect(function()
        if not antiFlingEnabled then return end
        pcall(function()
            local char = LP.Character
            if not char then return end
            local PrimaryPart = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not PrimaryPart then return end
            if PrimaryPart.AssemblyLinearVelocity.Magnitude > 250 or PrimaryPart.AssemblyAngularVelocity.Magnitude > 250 then
                PrimaryPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                PrimaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                if lastPosition then PrimaryPart.CFrame = lastPosition end
                showNotification("Anti-Fling", "Fling neutralized!", 3, "rbxassetid://6034281908", "success")
            elseif PrimaryPart.AssemblyLinearVelocity.Magnitude < 50 or PrimaryPart.AssemblyAngularVelocity.Magnitude < 50 then
                lastPosition = PrimaryPart.CFrame
            end
        end)
    end)
    table.insert(antiFlingConnections, localHeartbeat)
    showNotification("Anti-Fling", "Protection enabled!", 2, "rbxassetid://6034281908", "success")
end

local function disableAntiFling()
    if not antiFlingEnabled then return end
    antiFlingEnabled = false
    for _, connection in ipairs(antiFlingConnections) do
        if connection then pcall(function() connection:Disconnect() end) end
    end
    antiFlingConnections = {}
    lastPosition = nil
    showNotification("Anti-Fling", "Protection disabled!", 2, "rbxassetid://6034281908", "error")
end

-- Kill Aura
local function autoEquipKnife()
    local char = LP.Character
    local backpack = LP:FindFirstChild("Backpack")
    local humanoid = char and char:FindFirstChild("Humanoid")
    if not char or not backpack or not humanoid then return nil end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(killAuraConfig.TOOL_NAME:lower()) then return tool end
    end
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(killAuraConfig.TOOL_NAME:lower()) then
            humanoid:EquipTool(tool)
            task.wait(killAuraConfig.EQUIP_DELAY)
            return tool
        end
    end
    return nil
end

local function findGunPlayer()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local closestPlayer = nil
    local closestDistance = killAuraConfig.Q_RANGE
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local targetChar = plr.Character
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar:FindFirstChild("Humanoid")
            if targetHrp and targetHum and targetHum.Health > 0 then
                local distance = (targetHrp.Position - myPos).Magnitude
                if distance <= killAuraConfig.Q_RANGE and distance < closestDistance then
                    local hasGun = false
                    for _, obj in pairs(targetChar:GetChildren()) do
                        if obj:IsA("Tool") and obj.Name:lower():find(killAuraConfig.TARGET_TOOL:lower()) then hasGun = true break end
                    end
                    if not hasGun then
                        local plrBackpack = plr:FindFirstChild("Backpack")
                        if plrBackpack then
                            for _, obj in pairs(plrBackpack:GetChildren()) do
                                if obj:IsA("Tool") and obj.Name:lower():find(killAuraConfig.TARGET_TOOL:lower()) then hasGun = true break end
                            end
                        end
                    end
                    if hasGun then closestDistance = distance closestPlayer = plr end
                end
            end
        end
    end
    return closestPlayer
end

local function oneShotKill(targetHrp, targetHumanoid, knife)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(hrp.Position, targetHrp.Position)
    task.wait(0.05)
    task.spawn(function()
        pcall(function() if knife.Enabled then knife:Activate() end end)
        for _, obj in pairs(knife:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                pcall(function()
                    obj:FireServer(targetHrp.Position)
                    obj:FireServer(targetHrp)
                    obj:FireServer(targetHumanoid)
                    obj:FireServer()
                end)
            elseif obj:IsA("RemoteFunction") then
                pcall(function() obj:InvokeServer(targetHrp.Position) end)
            end
        end
        local clickEvent = knife:FindFirstChild("MouseClick") or knife:FindFirstChild("ClickEvent") or knife:FindFirstChild("HitEvent")
        if clickEvent then pcall(function() clickEvent:FireServer(targetHrp.Position) end) end
        pcall(function()
            local toolHandle = knife:FindFirstChild("Handle") or knife:FindFirstChildOfClass("Part")
            if toolHandle then toolHandle.CFrame = targetHrp.CFrame end
        end)
    end)
    if killAuraConfig.ONE_SHOT then
        for i = 1, 3 do
            task.wait(0.1)
            task.spawn(function() pcall(function() if knife.Enabled then knife:Activate() end end) end)
        end
    end
end

local function qGunKill()
    if isOnCooldownQ then
        showNotification("Cooldown", "Q on cooldown!", 2, "rbxassetid://6034281908", "warning")
        return
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = findGunPlayer()
    if not target then
        showNotification("No Target", "No player with Gun found!", 2, "rbxassetid://6034281908", "error")
        return
    end
    local knife = autoEquipKnife()
    if not knife then
        showNotification("No Knife", "Knife not found!", 2, "rbxassetid://6034281908", "error")
        return
    end
    isOnCooldownQ = true
    local targetChar = target.Character
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar:FindFirstChild("Humanoid")
    if not targetHrp or not targetHum then isOnCooldownQ = false return end
    showNotification("Q Target", target.Name .. " found!", 2, "rbxassetid://6034287518", "info")
    local myCFrame = hrp.CFrame
    local targetPos = myCFrame.Position + (myCFrame.LookVector * killAuraConfig.Q_PULL_DISTANCE)
    targetHrp.CFrame = CFrame.new(targetPos, myCFrame.Position)
    targetHrp.Velocity = Vector3.new(0, 0, 0)
    targetHrp.RotVelocity = Vector3.new(0, 0, 0)
    targetHum.WalkSpeed = 0
    targetHum.JumpPower = 0
    targetHum.PlatformStand = true
    showNotification("Pulled", target.Name .. " pulled!", 2, "rbxassetid://6034287518", "success")
    oneShotKill(targetHrp, targetHum, knife)
    task.delay(1, function()
        if targetHum and targetHum.Parent then
            targetHum.WalkSpeed = 16
            targetHum.JumpPower = 50
            targetHum.PlatformStand = false
        end
        showNotification("Killed", target.Name .. " eliminated!", 2, "rbxassetid://6034287518", "success")
    end)
    task.delay(killAuraConfig.Q_COOLDOWN, function()
        isOnCooldownQ = false
        showNotification("Ready", "Q available!", 2, "rbxassetid://6034287518", "success")
    end)
end

local function enableKillAura()
    if killAuraConnection then pcall(function() killAuraConnection:Disconnect() end) killAuraConnection = nil end
    killAuraConnection = RS.Heartbeat:Connect(function()
        if not states.killAura then return end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        if not hrp or not humanoid then return end
        local knife = autoEquipKnife()
        if not knife then return end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local targetChar = plr.Character
                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                local targetHum = targetChar:FindFirstChild("Humanoid")
                if targetHrp and targetHum and targetHum.Health > 0 then
                    local distance = (targetHrp.Position - hrp.Position).Magnitude
                    if distance <= killAuraConfig.KILL_RANGE then
                        pcall(function()
                            hrp.CFrame = CFrame.new(hrp.Position, targetHrp.Position)
                            if knife.Enabled then knife:Activate() end
                        end)
                    end
                end
            end
        end
    end)
    showNotification("Kill Aura", "Auto kill active! Range: " .. killAuraConfig.KILL_RANGE, 2, "rbxassetid://6034287518", "success")
