        TS:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 85 * scale),
            Position = UDim2.new(1, 0, card.Position.Y.Scale, card.Position.Y.Offset)
        }):Play()
        task.delay(0.35, function()
            card:Destroy()
            for i, v in ipairs(activeNotifs) do
                if v == card then table.remove(activeNotifs, i) break end
            end
        end)
    end)

    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            TS:Create(card, TweenInfo.new(0.25), {Size = UDim2.new(0, 0, 0, 85 * scale)}):Play()
